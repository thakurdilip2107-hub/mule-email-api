<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<!-- mule-email-api | main | ALREADY NEW pattern | Expected: SKIPPED -->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
    <appender name="FILE" class="org.apache.log4j.RollingFileAppender">
        <param name="File" value="${app.home}/logs/mule-email-api.log"/>
        <layout class="org.apache.log4j.PatternLayout">
            <PatternLayout pattern="%d{ISO8601} %-5level [%thread] %logger{36} - %msg%n"/>
        </layout>
    </appender>
    <root><priority value="INFO"/><appender-ref ref="FILE"/></root>
</log4j:configuration>